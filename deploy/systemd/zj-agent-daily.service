[Unit]
Description=zj-agent daily crawler and notification job
After=network.target mysql.service

[Service]
Type=oneshot
User=fzkj
Group=fzkj
WorkingDirectory=/home/fzkj/scraper
Environment=PYTHONPATH=/home/fzkj/scraper/src
ExecStart=/home/fzkj/scraper/.venv/bin/python -m zj_agent.cli run weekly-job
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
