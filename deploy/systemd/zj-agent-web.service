[Unit]
Description=zj-agent admin web service
After=network.target mysql.service

[Service]
Type=simple
User=fzkj
Group=fzkj
WorkingDirectory=/home/fzkj/scraper
Environment=PYTHONPATH=/home/fzkj/scraper/src
ExecStart=/home/fzkj/scraper/.venv/bin/python -m zj_agent.cli serve --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
